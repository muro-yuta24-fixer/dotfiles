[user]
	name = Y.Muro
	email = 165998973+muro-yuta24-fixer@users.noreply.github.com
[core]
	bare = true
	autocrlf = input
	editor = nvim
	pager = delta
	quotepath = false
[init]
	defaultBranch = main
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
	ui = auto
[alias]
	a  = add
	al = add --all
	d  = diff
	ds = diff --staged
	co = checkout
	cm  = commit
	br = branch
	ba = branch -a
	sw = switch
	l = log --oneline
	lg = log
	r  = restore
	rs = restore --staged
	cl = clone
	st = status
	fh = fetch
	pl = pull
	rb = rebase
	ps = push
	pu = push -u origin HEAD
	sh = stash
	sp = stash pop
	clean-branch = "!git branch | grep -v '$(git branch --show-current)' | grep -v 'develop' | grep -v 'master' | grep -v 'main' | xargs git branch -D"
	hist = log --pretty=format:'%C(yellow)[%ad]%C(reset) %C(green)[%h]%C(reset) | %C(red)%s %C(bold red){{%an}}%C(reset) %C(blue)%d%C(reset)' --graph --date=short
	graph = log --graph --date=short --pretty=\"format:%C(yellow)%h %C(cyan)%ad %C(green)%an%Creset%x09%s %C(red)%d%Creset\"
	rv = revert
	wt = worktree
  mg = merge --no-edit
	reset-local = reset --hard origin/HEAD
[pull]
	rebase = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/mise x -- gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/mise x -- gh auth git-credential
[push]
	autoSetupRemote = true
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[ghq]
root = "~/.ghq"
[worktree]
	guessRemote = true
[delta]
	navigate = true
  side-by-side = true
  line-numbers = true
	dark = true
  minus-style                   = syntax "#380605"
  minus-non-emph-style          = syntax "#380605"
  minus-emph-style              = syntax "#570f0e"
  minus-empty-line-marker-style = syntax "#380605"
  line-numbers-minus-style      = "#db302d"
  plus-style                    = syntax "#103a3c"
  plus-non-emph-style           = syntax "#103a3c"
  plus-emph-style               = syntax "#2c3300"
  plus-empty-line-marker-style  = syntax "#103a3c"
  line-numbers-plus-style       = "#849900"
  line-numbers-zero-style       = "#576d74"
	# Should match the name of the bat theme
	syntax-theme = Solarized (dark)
[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true
[rerere]
	enabled = true
